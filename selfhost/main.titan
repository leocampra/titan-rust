import ast
import checker
import io
import lexer
import parser
import texto

-- Driver do titanc auto-hospedado (PRD.md, Parte C).
--
-- Cresce uma tarefa de cada vez. Hoje ele faz tres coisas, conforme os
-- argumentos:
--
--   titanc --manifesto selfhost --out /tmp/x
--   /tmp/x/titanself                                -> a demonstracao da ast (T84)
--   /tmp/x/titanself --tokens examples/nucleo.titan -> a lista de tokens (T85)
--   /tmp/x/titanself examples/nucleo.titan          -> a arvore sintatica (T86)
--   /tmp/x/titanself --checar examples/nucleo.titan -> a analise semantica (T87)
--
-- Sem argumento ele monta a `Exp` recursiva de `1 + 2 * 3` com o `enum` da ast
-- e a percorre com `match`, imprimindo a arvore reparentizada e o numero de
-- nos — a mesma construcao que o teste de integracao da T84 confere, e que
-- continua valendo palavra por palavra.
--
-- Com `--tokens` e um arquivo, tokeniza-o com selfhost/lexer.titan e imprime
-- uma linha por token, no formato de examples/lexer.titan — o que o teste de
-- equivalencia da T85 compara com a saida do lexer da Fase 4. A T85 nao tinha
-- a flag (o arquivo sozinho bastava); a T86 a introduziu ao dar ao arquivo
-- sozinho o significado novo de "parseia", e o teste de equivalencia passou a
-- chamar com ela.
--
-- Com um arquivo e mais nada, lexa, parseia com selfhost/parser.titan e
-- imprime a arvore — ou os erros de sintaxe, um por linha, saindo com 1. E o
-- criterio de aceite da T86.
--
-- Com `--checar` e um arquivo, lexa, parseia e checa com selfhost/
-- checker.titan — imprimindo "ok: <arquivo>" e saindo com 0, ou os erros de
-- tipo (linha, coluna e mensagem, um por linha) e saindo com 1. E o criterio
-- de aceite da T87.
--
-- A tarefa seguinte amarra as tres pecas numa so saida — a AST **tipada** — e
-- compara o resultado com o do `titanc` sobre os mesmos fontes (T88).

function exemplo(): ast.Exp
    -- 1 + 2 * 3, com a precedencia ja resolvida na forma da arvore: o `*`
    -- e o filho direito do `+`, e nao um irmao.
    --
    -- Cada no vai para um `local` em vez de encaixar as chamadas umas nas
    -- outras. Nao e estilo: passar o mesmo `Loc` para a chamada de fora e para
    -- uma chamada aninhada faz o codegen emitir dois `&mut l` vivos ao mesmo
    -- tempo (ADR 0007), e o rustc reclama em ingles. Com os `local` as chamadas
    -- ficam sequenciadas e cada emprestimo termina antes do proximo.
    local l: ast.Loc = ast.loc(1, 1)
    local um: ast.Exp = ast.inteiro(l, 1)
    local dois: ast.Exp = ast.inteiro(l, 2)
    local tres: ast.Exp = ast.inteiro(l, 3)
    local dois_vezes_tres: ast.Exp = ast.binop(l, "*", dois, tres)
    return ast.binop(l, "+", um, dois_vezes_tres)
end

-- A demonstracao da T84: constroi a arvore e a percorre com `match`.
function demonstrar_ast(): nil
    local e: ast.Exp = exemplo()
    print("arvore: " .. ast.exp_para_texto(e))
    print("nos: " .. ast.tamanho_da_exp(e))
    print("linha: " .. ast.loc_da_exp(e).linha)
end

-- A demonstracao da T85: tokeniza o arquivo e imprime um token por linha.
--
-- Um `print` por token, e nao um `print` de `lexer.tokens_para_texto` inteiro:
-- aquela funcao termina cada linha com `\n`, e `print` acrescenta mais um — a
-- saida sairia com uma linha em branco no fim e a comparacao com o lexer da
-- Fase 4 falharia por um byte. A capability `io` nao tem escrita em stdout sem
-- quebra de linha, e acrescentar uma esta fora do escopo desta tarefa.
-- `tokens_para_texto` continua sendo o que o teste de equivalencia usa.
function tokenizar_arquivo(caminho: string): nil
    local fonte: string = io.ler_arquivo(caminho)
    local tokens: {lexer.Token} = lexer.tokenizar(fonte)
    for t in tokens do
        print(lexer.token_para_texto(t))
    end
end

-- A demonstracao da T86: parseia o arquivo e imprime a arvore.
--
-- O codigo de saida distingue os dois desfechos, porque e o que um driver de
-- compilador deve fazer e o que a T88 vai comparar com o `titanc`: 0 quando o
-- fonte parseia, 1 quando ha erro de sintaxe. Os erros saem todos, e nao so o
-- primeiro — o parser acumula em vez de abortar (T86).
function parsear_arquivo(caminho: string): integer
    local fonte: string = io.ler_arquivo(caminho)
    local erros: {parser.Erro} = {}
    local topos: {ast.TopLevel} = parser.parse_fonte(fonte, erros)
    if #erros > 0 then
        for e in erros do
            print(parser.erro_para_texto(e))
        end
        return 1
    end
    -- Um `print` por declaracao de topo, e nao um `print` do programa inteiro:
    -- `programa_para_texto` termina cada linha com `\n` e `print` acrescenta
    -- outro. E a mesma razao que fez `tokenizar_arquivo` imprimir token a
    -- token, e o mesmo limite da capability `io`.
    for t in topos do
        local txt: string = ast.toplevel_para_texto(t)
        print(texto_sem_quebra_final(txt))
    end
    return 0
end

-- A demonstracao da T87: lexa, parseia e **checa** o arquivo.
--
-- Uma flag nova, e nao o significado novo do arquivo sozinho: a T86 pode
-- trocar o significado do argumento nu porque o que ela substituiu (a lista de
-- tokens da T85) virou `--tokens` no mesmo commit, e um teste so olhava. Aqui
-- meia duzia de testes da T86 leem a arvore do argumento nu, e a amarracao
-- definitiva do pipeline e tarefa da T88 — trocar agora seria mexer duas
-- vezes no mesmo lugar, a segunda para desfazer parte da primeira.
--
-- O codigo de saida segue a convencao do `parsear_arquivo`: 0 quando o
-- programa passa nas duas analises, 1 quando ha erro — de sintaxe ou de tipo.
-- Erro de sintaxe **para** antes da checagem, e nao por economia: o parser
-- devolve uma arvore parcial com nos de escape (`ast.nil_exp` no lugar de uma
-- expressao que nao parseou), e checar isso produziria erros de tipo sobre
-- codigo que o autor nao escreveu.
function checar_arquivo(caminho: string): integer
    local fonte: string = io.ler_arquivo(caminho)
    local erros_de_sintaxe: {parser.Erro} = {}
    local topos: {ast.TopLevel} = parser.parse_fonte(fonte, erros_de_sintaxe)
    if #erros_de_sintaxe > 0 then
        for e in erros_de_sintaxe do
            print(parser.erro_para_texto(e))
        end
        return 1
    end
    local erros_de_tipo: {checker.ErroDeTipo} = {}
    checker.checa_programa(topos, erros_de_tipo, true)
    if #erros_de_tipo > 0 then
        for e in erros_de_tipo do
            print(checker.erro_para_texto(e))
        end
        return 1
    end
    print("ok: " .. caminho)
    return 0
end

-- O texto sem o `\n` final, para o `print` nao dobrar a quebra de linha.
function texto_sem_quebra_final(s: string): string
    local n: integer = texto.tamanho(s)
    if n > 0 and texto.byte(s, n) == 10 then
        return texto.sub(s, 1, n - 1)
    end
    return s
end

function main(args: {string}): integer
    if #args < 1 then
        demonstrar_ast()
        return 0
    end
    if args[1] == "--tokens" then
        if #args < 2 then
            print("uso: titanself --tokens <arquivo.titan>")
            return 1
        end
        tokenizar_arquivo(args[2])
        return 0
    end
    if args[1] == "--checar" then
        if #args < 2 then
            print("uso: titanself --checar <arquivo.titan>")
            return 1
        end
        return checar_arquivo(args[2])
    end
    return parsear_arquivo(args[1])
end
